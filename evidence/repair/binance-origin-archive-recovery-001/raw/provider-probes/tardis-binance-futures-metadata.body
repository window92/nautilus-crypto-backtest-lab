2024-03-29T00:00:00.000Z","availableTo":"2024-09-28T00:00:00.000Z"},{"id":"ETHUSDT_241227","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2024-06-28T00:00:00.000Z","availableTo":"2024-12-28T00:00:00.000Z"},{"id":"ETHUSDT_250328","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2024-09-27T00:00:00.000Z","availableTo":"2025-03-29T00:00:00.000Z"},{"id":"ETHUSDT_250627","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2024-12-27T00:00:00.000Z","availableTo":"2025-06-28T00:00:00.000Z"},{"id":"ETHUSDT_250926","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2025-03-28T00:00:00.000Z","availableTo":"2025-09-27T00:00:00.000Z"},{"id":"ETHUSDT_251226","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2025-06-27T00:00:00.000Z","availableTo":"2025-12-27T00:00:00.000Z"},{"id":"ETHUSDT_260327","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2025-09-26T00:00:00.000Z","availableTo":"2026-03-28T00:00:00.000Z"},{"id":"ETHUSDT_260626","type":"future","dataTypes":["trades","incremental_book_L2","quotes","book_snapshot_5","book_snapshot_25","derivative_ticker","liquidations","book_ticker"],"availableSince":"2025-12-26T00:00:00.000Z","availableTo":"2026-06-27T00:00:00.000Z"}]},"incidentReports":[{"from":"2026-08-13T14:33:00.000Z","to":"2026-08-13T14:36:00.000Z","status":"resolved","details":"Partial data gaps were caused by a brief connectivity interruption affecting real-time data collection. Normal recording resumed after the affected connections recovered."},{"from":"2026-07-27T22:40:00.000Z","to":"2026-07-28T08:45:00.000Z","status":"resolved","details":"Missing data caused by a wave of rapid WebSocket reconnects that exhausted Binance API rate limits and triggered repeated IP bans that were difficult to work around, prolonging recovery."},{"from":"2026-07-14T12:30:07.786Z","to":"2026-07-14T14:10:47.151Z","status":"resolved","details":"Partial Binance Futures data gaps were caused by an internal rate-limit handling issue. After a WebSocket disconnect, REST requests for initial order book snapshots hit temporary Binance IP bans, causing repeated reconnects and missing real-time and generated REST data. Most channels progressively recovered between 12:58 and 13:00 UTC, and 13:01 UTC is the first complete minute. Open interest remained incomplete during recovery and was completely absent from 12:59 through 14:09 UTC. Normal open-interest recording resumed at 2026-07-14T14:10:47 UTC, with 14:11 UTC as its first complete minute. Request retry and rate-limit handling was corrected."},{"from":"2026-06-22T04:25:00.000Z","to":"2026-06-22T04:30:00.000Z","status":"resolved","details":"Missing data in exchange-specific minute slices caused by a transient Tokyo recorder infrastructure/network disruption. Some affected slices are empty or contain only reconnect markers. Normal recording resumed after reconnects completed around 2026-06-22T04:29:50 UTC."},{"from":"2026-06-12T03:58:00.000Z","to":"2026-06-12T04:28:50.000Z","status":"resolved","details":"Missing data caused by an internal recorder infrastructure failure. Normal recording resumed after automated recovery kicked-in."},{"from":"2026-06-08T09:48:00.000Z","to":"2026-06-08T09:48:43.654Z","status":"resolved","details":"Short data gap caused by a Tokyo recorder stability issue. Recording resumed at 2026-06-08T09:48:43.654Z UTC."},{"from":"2026-06-08T08:52:00.000Z","to":"2026-06-08T08:53:03.413Z","status":"resolved","details":"Short data gap caused by a Tokyo recorder stability issue. The 08:52 UTC minute slice contains only a reconnect marker; recording resumed at 2026-06-08T08:53:03.413Z UTC."},{"from":"2026-05-21T16:31:00.000Z","to":"2026-05-21T16:57:00.000Z","status":"resolved","details":"Missing data caused by an internal recorder infrastructure failure. Normal recording resumed after automated recovery."},{"from":"2026-03-26T08:34:51.160Z","to":"2026-03-26T08:44:59.308Z","status":"resolved","details":"Missing data caused by a recorder reconnect loop after repeated Binance Futures WebSocket read cancellations. Repeated full client rebuilds hit Binance REST -1003 rate limits while rebuilding subscriptions."},{"from":"2025-08-29T06:18:03.205Z","to":"2025-08-29T06:37:04.820Z","status":"resolved","details":"Missing trade, bookTicker, and depth data caused by a Binance Futures exchange-side outage affecting USD-margined futures. Other lower-volume streams continued during the window. Normal trade recording resumed at 2025-08-29T06:37:04.820Z UTC."},{"from":"2023-05-10T13:00:00.000Z","to":"2023-05-10T14:13:00.000Z","status":"resolved","details":"Missing data due to hitting Binance Futures rate limits for HTTP requests (403 error), fix was implemented (HTTP proxy & multiple IPs) and deployed."},{"from":"2022-04-08T05:00:00.000Z","to":"2022-04-08T12:00:00.000Z","status":"resolved","details":"Increased disconnections count and WS connections timeouts resulting in small data gaps."},{"from":"2022-03-06T21:10:00.000Z","to":"2022-03-07T02:43:00.000Z","status":"resolved","details":"Missing BTCUSDT instrument data caused by Binance API not publishing any messages over open connection except @markPrice stream, additional checks have been added to restart connection in such case."},{"from":"2021-05-12T07:02:00.000Z","to":"2021-05-12T07:42:00.000Z","status":"resolved","details":"GKE node network issue resulted triggering auto-repair logic and missing data in that period."},{"from":"2021-03-05T14:14:00.000Z","to":"2021-03-05T14:23:00.000Z","status":"resolved","details":"Missing data due to virtual machine crash. Crash was caused by hardware issue on the physical machine hosting VM which has been automatically replaced with healthy one by auto-repair logic."},{"from":"2020-06-11T18:32:00.000Z","to":"2020-06-11T19:55:00.000Z","status":"resolved","details":"Intermittent Kubernetes Node network issue caused increased disconnections count and establishing connection timeouts that resulted in missing data."},{"from":"2020-05-14T12:29:59.000Z","to":"2020-05-14T12:30:07.000Z","status":"resolved","details":"Missing data (~8 seconds) caused by moving Binance Futures data collection infrastructure from London to Tokyo GKE cluster."},{"from":"2020-01-06T00:00:00.000Z","to":"2020-02-28T00:00:00.000Z","status":"resolved","details":"Occasional initial order book snapshots not overlapping with depthUpdate messages for all instruments. This bug has been introduced when switching to @0ms depth channel. Logic that was checking mentioned scenario was not validating correctly @depth@0ms messages."}]}