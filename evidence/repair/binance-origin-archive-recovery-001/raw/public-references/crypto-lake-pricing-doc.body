<script>
    function setCookie(name, value, days = 30) {
        var expires = "";
        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
    }
    function getCookie(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    }
    var campaign = {}
    // Remove unwanted params (twclid so far)
    try {
        const params = new URL(window.location.href).searchParams;
        if (params.has('twclid')) {
            params.delete('twclid');
            campaign['source'] = 'twitter';
        }
        if (params.has('gclid')) {
            params.delete('gclid');
            campaign['source'] = 'google';
        }
        var page_location = location.protocol + '//' + location.host + location.pathname;
        if (params.toString()) {
            page_location += '?' + params.toString();
        }
        if (location.hash) {
            page_location += location.hash;
        }
        console.log('Page location: ' + page_location);
    } catch {
        var page_location = location.href;
    }
    if (!getCookie('firsttime') && campaign['source']) {
        setCookie('source', campaign['source'], 30);
    }
    if (!getCookie('firsttime') && campaign['medium']) {
        setCookie('medium', campaign['medium'], 30);
    }
    if (!getCookie('firsttime')) {
        setCookie('firsttime', new Date().toISOString(), 30);
        setCookie('firstlocation', window.location.href, 30);
        setCookie('firstreferrer', document.referrer, 30);
    }
    var track_click = function(url, name) {
        dataLayer.push({
            'event': name,
            'event_label': url,
            'transport_type': 'beacon'
        });
        document.location = url;
    }
    var track_event = function(name, category = '', label = '', value = '') {
        dataLayer.push({
            'event': name,
            'event_category': category,
            'event_label': label,
            'transport_type': 'beacon'
        });
        if (value) {
            dataLayer[dataLayer.length-1]['value'] = value;
            dataLayer[dataLayer.length-1]['currency'] = 'USD';
        }
    }
    var twq = function(name, category = '', label = '') {
        dataLayer.push({
            'event': name,
            'event_category': category,
            'event_label': label,
            'transport_type': 'beacon'
        });
    }
</script>
