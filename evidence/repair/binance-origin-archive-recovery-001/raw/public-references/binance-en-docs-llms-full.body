          "channelCode": "Paypal",
          "paymentMethod": "PayPal",
          "p2p": true,
          "withdrawRestriction": 0
        }
      ]
    },
    {
      "fiat": "EUR",
      "paymentMethods": [
        {
          "paymentMethodCode": "BUY_WALLET",
          "channelCode": "Wallet",
          "paymentMethod": "Spot Wallet",
          "p2p": false,
          "withdrawRestriction": 0
        },
        {
          "paymentMethodCode": "BUY_CARD",
          "channelCode": "card",
          "paymentMethod": "Card (VISA/Mastercard)",
          "p2p": false,
          "withdrawRestriction": 0
        },
        {
          "payMethodCode": "BUY_REVOLUT",
          "payMethodSubCode": "REVOLUT",
          "paymentMethod": "REVOLUT",
          "p2p": false,
          "withdrawRestriction": 0
        },
        {
          "paymentMethodCode": "BUY_P2P",
          "channelCode": "SEPA",
          "paymentMethod": "SEPA (EU) bank transfer",
          "p2p": true,
          "withdrawRestriction": 0
        }
      ]
    },
    {
      "fiat": "CNY",
      "paymentMethods": [
        {
          "paymentMethodCode": "BUY_P2P",
          "channelCode": "ALIPAY",
          "paymentMethod": "Alipay English",
          "p2p": true,
          "withdrawRestriction": 1
        },
        {
          "paymentMethodCode": "BUY_P2P",
          "channelCode": "BANK",
          "paymentMethod": "Bank",
