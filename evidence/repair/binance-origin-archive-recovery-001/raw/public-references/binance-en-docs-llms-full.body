    "networkFee": "0.5",
    "withdrawWalletAddress": "0xbb4CdB98Bd36B01bD1cBaEA52De08d9173bc095c",
    "withdrawNetwork": "ETH",
    "withdrawMemo": "",
    "withdrawTxHash": "0xcb163e2e6322cd6aa7bc4d45306029e846c0c06e9cdee45a06e88801d1231e71",
