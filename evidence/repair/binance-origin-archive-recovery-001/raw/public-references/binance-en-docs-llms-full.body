      "cryptoCurrency": "SOL",
      "fiatCurrency": "AED",
      "quotation": 0.055,
      "changes": -4.81
    },
    {
      "cryptoCurrency": "USDT",
      "fiatCurrency": "AED",
      "quotation": 0.000051,
      "changes": -5.41
    },
