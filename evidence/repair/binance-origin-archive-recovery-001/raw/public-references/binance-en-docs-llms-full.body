      ["0.08521196", "320.94000000"],
      ["0.08529880", "0.00000000"],
      ["0.08529885", "0.00000000"]
    ],
    "e": "depthUpdate",
    "pu": 42648947321, // Previous updateId from the last push
    "s": "ALPHA_474USDT",
    "u": 42648948229 // Last updateId in this event
  },
  "stream": "alpha_474usdt@fulldepth@500ms"
}
```

